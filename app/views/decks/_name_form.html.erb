<%#
  O formulário do nome, usado para criar e, na T11, para renomear. A mensagem
  vem de `errors[:name]`, e não de `full_messages`: o app não tem locale pt, e
  `full_messages` prefixaria o nome do atributo em inglês ("Name não pode
  ficar vazio"). O resumo tem `role="alert"` pelo mesmo motivo do cadastro:
  quem usa leitor de tela precisa saber o que houve sem varrer o formulário.
%>
<% if deck.errors[:name].any? %>
  <div role="alert" tabindex="-1">
    <ul>
      <% deck.errors[:name].each do |message| %>
        <li>O nome <%= message %>.</li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: deck do |form| %>
  <div>
    <%= form.label :name, "Nome do deck" %>
    <%= form.text_field :name, required: true, maxlength: Deck::NAME_LENGTH.max, autofocus: true %>
  </div>

  <%= form.submit submit %>
<% end %>
