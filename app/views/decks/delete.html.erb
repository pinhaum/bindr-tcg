<% content_for :title, "Excluir deck" %>

<%#
  DCK-09 — a confirmação em página própria, como a do import da coleção
  (`collection_imports/show.html.erb`): sem JS, testável por integração, e
  nada é apagado só por abrir esta página.
%>
<main class="deck">
  <h1 class="deck__title">Excluir o deck “<%= @deck.name %>”?</h1>

  <p class="deck__summary">O deck e as cartas dele somem. Sua coleção e sua wishlist não mudam.</p>

  <%= button_to "Excluir deck", deck_path(@deck), method: :delete, class: "deck__button", form_class: "deck__form" %>

  <p class="deck__actions"><%= link_to "Cancelar", deck_path(@deck), class: "deck__action" %></p>
</main>
