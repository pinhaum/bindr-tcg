<% content_for :title, "Criar conta" %>

<main class="auth">
  <h1 class="auth__title">Criar conta</h1>

  <%# Os erros do model vão num resumo com foco, e não só ao lado de cada campo:
      quem usa leitor de tela precisa saber o que houve sem varrer o formulário. %>
  <% if @user.errors.any? %>
    <div class="auth__errors" role="alert" tabindex="-1">
      <p><%= pluralize(@user.errors.count, "erro impediu", plural: "erros impediram") %> a criação da conta:</p>
      <ul>
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @user, url: registration_path, class: "auth__form" do |form| %>
    <div class="auth__field">
      <%= form.label :email, "E-mail" %>
      <%= form.email_field :email, required: true, autocomplete: "email", autofocus: true %>
    </div>

    <div class="auth__field">
      <%= form.label :password, "Senha" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password" %>
    </div>

    <div class="auth__field">
      <%= form.label :password_confirmation, "Confirme a senha" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password" %>
    </div>

    <%= form.submit "Criar conta", class: "auth__submit" %>
  <% end %>

  <p class="auth__alt">
    Já tem conta? <%= link_to "Entrar", new_session_path %>
  </p>
</main>
