<% content_for :title, "Catálogo" %>

<main class="catalog">
  <div class="catalog__head">
    <h1 class="catalog__title">Catálogo</h1>

    <%#
      Busca e linha de status agrupadas (CNF-08): em ≥1024px ficam na mesma
      linha, com "Limpar filtros" à direita da busca; abaixo disso, o wrapper
      não é flex e os dois blocos empilham como sempre.
    %>
    <div class="catalog__head-row">
      <form class="catalog__search" method="get" action="<%= catalog_path %>" role="search">
        <label class="catalog__search-label" for="catalog-q">Buscar por nome ou card_number</label>
        <input id="catalog-q" type="search" name="q" value="<%= @result.active_filters[:q] %>"
               placeholder="OP01-024">
        <button type="submit">Buscar</button>
      </form>

      <%#
        Linha de status como frase única (CNF-05): "N cartas" sozinho, ou
        acrescido de " · M filtros ativos" quando há filtro — um só <p>, não
        dois números soltos lado a lado.
      %>
      <% filter_count = active_filter_count(@result.active_filters) %>
      <div class="catalog__status">
        <p class="catalog__count">
          <%= pluralize(@result.total_count, "carta", plural: "cartas") %>
          <% if filter_count > 0 %>
            <span class="catalog__filter-count">
              · <%= pluralize(filter_count, "filtro ativo", plural: "filtros ativos") %>
            </span>
          <% end %>
        </p>

        <% if filter_count > 0 %>
          <%# Com zero resultados, quem oferece "Limpar filtros" é o estado vazio. %>
          <% if @result.records.any? %>
            <%= link_to "Limpar filtros", clear_filters_url(@result.active_filters), class: "catalog__clear-filters" %>
          <% end %>
        <% end %>

        <%#
          Convite único ao anônimo (CNF-07): vive na linha de status e em
          nenhum outro lugar da página — os tiles pararam de oferecer o
          próprio convite na T3.
        %>
        <% unless authenticated? %>
          <%= link_to "Entrar para registrar posse", new_session_path, class: "catalog__signin-invite" %>
        <% end %>
      </div>
    </div>

    <% chips = catalog_chips(@result.active_filters) %>
    <% if chips.any? %>
      <ul class="catalog__chips" aria-label="Filtros ativos">
        <% chips.each do |chip| %>
          <li class="filter-chip">
            <span class="filter-chip__label"><%= chip.label %>: <%= chip.value %></span>
            <%= link_to chip.url, class: "filter-chip__remove",
                        "aria-label": "Remover filtro #{chip.label}: #{chip.value}" do %>
              <span aria-hidden="true">&times;</span>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>

  <details class="catalog__filters-toggle">
    <% filter_count = active_filter_count(@result.active_filters) %>
    <summary class="catalog__filters-summary">
      Filtros
      <% if filter_count > 0 %>
        <span class="catalog__filters-count">
          <%= pluralize(filter_count, "filtro ativo", plural: "filtros ativos") %>
        </span>
      <% end %>
    </summary>

    <div class="catalog__filters">
      <%# Chips de cor — NAV-33, NAV-34 %>
    <div class="catalog__filter-group">
      <h2 class="catalog__filter-title">Cor</h2>
      <div class="catalog__chips-group">
        <% @filter_options[:colors].each do |color| %>
          <% is_active = Array(@result.active_filters[:colors]).include?(color) %>
          <% url = filter_toggle_url(@result.active_filters, :colors, color) %>
          <a href="<%= url %>" class="catalog__chip catalog__chip--color<%= " catalog__chip--active" if is_active %>"
             <% if is_active %>aria-label="Remover filtro Cor: <%= color %>"<% end %>>
            <span aria-hidden="true" class="catalog__chip-swatch"></span>
            <%= color %>
            <% if is_active %><span aria-hidden="true">&times;</span><% end %>
          </a>
        <% end %>
      </div>
    </div>

    <%# Chips de tipo — NAV-33, NAV-34 %>
    <div class="catalog__filter-group">
      <h2 class="catalog__filter-title">Tipo</h2>
      <div class="catalog__chips-group">
        <% @filter_options[:card_types].each do |card_type| %>
          <% is_active = Array(@result.active_filters[:card_types]).include?(card_type) %>
          <% url = filter_toggle_url(@result.active_filters, :card_types, card_type) %>
          <a href="<%= url %>" class="catalog__chip<%= " catalog__chip--active" if is_active %>"
             <% if is_active %>aria-label="Remover filtro Tipo: <%= card_type %>"<% end %>>
            <%# Exibição com inicial maiúscula (CNF-11); a URL continua o valor cru. %>
            <%= card_type.capitalize %>
            <% if is_active %><span aria-hidden="true">&times;</span><% end %>
          </a>
        <% end %>
      </div>
    </div>

    <%# Chips de raridade — NAV-33, NAV-34 %>
    <div class="catalog__filter-group">
      <h2 class="catalog__filter-title">Raridade</h2>
      <div class="catalog__chips-group">
        <% @filter_options[:rarities].each do |rarity| %>
          <% is_active = Array(@result.active_filters[:rarities]).include?(rarity) %>
          <% url = filter_toggle_url(@result.active_filters, :rarities, rarity) %>
          <a href="<%= url %>" class="catalog__chip<%= " catalog__chip--active" if is_active %>"
             <% if is_active %>aria-label="Remover filtro Raridade: <%= rarity %>"<% end %>>
            <%= rarity %>
            <% if is_active %><span aria-hidden="true">&times;</span><% end %>
          </a>
        <% end %>
      </div>
    </div>

    <%# Formulário de set — NAV-14 (set continua em form GET com botão "Aplicar") %>
    <form method="get" action="<%= catalog_path %>">
    <%# Filtros ativos sem controle, preservados como hidden %>
    <% if @result.active_filters[:q].present? %>
      <input type="hidden" name="q" value="<%= @result.active_filters[:q] %>">
    <% end %>
    <% if @result.active_filters[:cost_min].present? %>
      <input type="hidden" name="cost_min" value="<%= @result.active_filters[:cost_min] %>">
    <% end %>
    <% if @result.active_filters[:cost_max].present? %>
      <input type="hidden" name="cost_max" value="<%= @result.active_filters[:cost_max] %>">
    <% end %>
    <% if @result.active_filters[:power_min].present? %>
      <input type="hidden" name="power_min" value="<%= @result.active_filters[:power_min] %>">
    <% end %>
    <% if @result.active_filters[:power_max].present? %>
      <input type="hidden" name="power_max" value="<%= @result.active_filters[:power_max] %>">
    <% end %>
    <% if @result.active_filters[:counter_min].present? %>
      <input type="hidden" name="counter_min" value="<%= @result.active_filters[:counter_min] %>">
    <% end %>
    <% if @result.active_filters[:counter_max].present? %>
      <input type="hidden" name="counter_max" value="<%= @result.active_filters[:counter_max] %>">
    <% end %>
    <% if @result.active_filters[:traits].present? %>
      <% Array(@result.active_filters[:traits]).each do |trait| %>
        <input type="hidden" name="traits[]" value="<%= trait %>">
      <% end %>
    <% end %>
    <% if @result.active_filters[:attributes].present? %>
      <% Array(@result.active_filters[:attributes]).each do |attr| %>
        <input type="hidden" name="attributes[]" value="<%= attr %>">
      <% end %>
    <% end %>
    <% if @result.active_filters[:sort].present? %>
      <input type="hidden" name="sort" value="<%= @result.active_filters[:sort] %>">
    <% end %>
    <% if @result.active_filters[:dir].present? %>
      <input type="hidden" name="dir" value="<%= @result.active_filters[:dir] %>">
    <% end %>
    <% if @result.active_filters[:colors].present? %>
      <% Array(@result.active_filters[:colors]).each do |color| %>
        <input type="hidden" name="colors[]" value="<%= color %>">
      <% end %>
    <% end %>
    <% if @result.active_filters[:card_types].present? %>
      <% Array(@result.active_filters[:card_types]).each do |card_type| %>
        <input type="hidden" name="card_types[]" value="<%= card_type %>">
      <% end %>
    <% end %>
    <% if @result.active_filters[:rarities].present? %>
      <% Array(@result.active_filters[:rarities]).each do |rarity| %>
        <input type="hidden" name="rarities[]" value="<%= rarity %>">
      <% end %>
    <% end %>
    <% if @result.active_filters[:owned].present? %>
      <input type="hidden" name="owned" value="<%= @result.active_filters[:owned] %>">
    <% end %>

    <div class="catalog__filter-group">
      <label for="filter-sets">Set</label>
      <select id="filter-sets" name="sets[]">
        <% sets_count = Array(@result.active_filters[:sets]).size %>
        <% is_multiple_or_none = sets_count > 1 || sets_count == 0 %>
        <option value="" <% if is_multiple_or_none %>selected<% end %>>Todos os sets</option>
        <% @filter_options[:sets].each do |set_option| %>
          <option value="<%= set_option[:code] %>"
                  <% if sets_count == 1 && Array(@result.active_filters[:sets]).include?(set_option[:code]) %>selected<% end %>>
            <%= set_option[:name] %>
          </option>
        <% end %>
      </select>
    </div>

    <%# Se houver mais de um set ativo, coloca os extras como hidden %>
    <% if Array(@result.active_filters[:sets]).size > 1 %>
      <% Array(@result.active_filters[:sets]).each do |set_code| %>
        <input type="hidden" name="sets[]" value="<%= set_code %>">
      <% end %>
    <% end %>

    <button type="submit">Aplicar</button>
  </form>

    <%# Chips de posse (com sessão) — NAV-33, NAV-34 %>
    <% if authenticated? %>
      <% owned_value = @result.active_filters[:owned] %>
      <% active_owned = CatalogQuery::OWNERSHIP_VALUES.include?(owned_value) ? owned_value : "all" %>
      <div class="catalog__filter-group">
        <h2 class="catalog__filter-title">Posse</h2>
        <div class="catalog__chips-group">
          <% [ "all", "owned", "missing" ].each do |val| %>
            <% label_text = val == "all" ? "Todas" : (val == "owned" ? "Tenho" : "Não tenho") %>
            <% is_active = active_owned == val %>
            <% url = filter_toggle_url(@result.active_filters, :owned, val) %>
            <%#
              "Todas" sem `owned` ativo não é uma remoção (CNF-31): é a
              ausência do filtro, marcada como atual com `aria-current`, sem
              "×" e sem o nome acessível "Remover filtro" que prometeria uma
              remoção que não acontece.
            %>
            <% if val == "all" && is_active %>
              <a href="<%= url %>" class="catalog__chip catalog__chip--active" aria-current="true">
                <%= label_text %>
              </a>
            <% else %>
              <a href="<%= url %>" class="catalog__chip<%= " catalog__chip--active" if is_active %>"
                 <% if is_active %>aria-label="Remover filtro Posse: <%= label_text %>"<% end %>>
                <%= label_text %>
                <% if is_active %><span aria-hidden="true">&times;</span><% end %>
              </a>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
    </div>
  </details>

  <div class="catalog__body">
    <% if @result.records.empty? %>
    <section class="catalog__empty">
      <p>
        <% if @result.active_filters[:q].present? %>
          Nenhuma carta encontrada para <strong><%= @result.active_filters[:q] %></strong>.
        <% else %>
          Nenhuma carta corresponde aos filtros aplicados.
        <% end %>
      </p>
      <%= link_to "Limpar filtros", clear_filters_url(@result.active_filters), class: "catalog__empty-reset" %>
    </section>
  <% else %>
    <ul class="catalog__grid">
      <%= render partial: "catalog/card_tile", collection: @result.records, as: :card %>
    </ul>

    <%= render "catalog/pagination", result: @result %>
  <% end %>
  </div>
</main>
