<% content_for :title, "#{@card.name} (#{@card.card_number})" %>
<% content_for :sidebar_actions do %>
  <%= link_to "Voltar ao catálogo", catalog_path, class: "site-header__back" %>
<% end %>

<main class="card-detail">

  <% if @variants.any? %>
    <%# CNF-42 / SRC-17 — `@hero` é a variante escolhida em `?variant=` ou, sem escolha válida, a primeira presente. %>
    <% hero = @hero %>
    <% hero_quantity = owned_quantity(hero) %>

    <%#
      CNF-14/15 — abaixo de 1024px a miniatura fica ao lado do título e a
      imagem maior abre num `<details>`, sem JavaScript. Em 1024px ou mais o
      CSS abre o `<details>` e o transforma numa coluna de 320px sempre
      visível (T6, `card_detail_media_test.rb`) — é o mesmo elemento nos dois
      casos, não uma segunda cópia da imagem.
    %>
    <div class="card-detail__head">
      <div class="card-detail__thumb">
        <div class="card-detail__placeholder" aria-hidden="true">
          <span><%= @card.name %></span>
          <span><%= @card.card_number %></span>
        </div>

        <% if hero.image_url.present? %>
          <%= image_tag card_image_path(hero.variant_code),
                        alt: "#{@card.name} #{hero.variant_code}",
                        class: "card-detail__image" %>
        <% end %>

        <% if hero_quantity.positive? %>
          <span class="card-detail__badge" role="img" aria-label="<%= hero_quantity == 1 ? "1 cópia" : "#{hero_quantity} cópias" %>"><%= hero_quantity %></span>
        <% end %>
      </div>

      <header class="card-detail__heading">
        <h1 class="card-detail__name"><%= @card.name %></h1>
        <p class="card-detail__number"><%= @card.card_number %></p>

        <%#
          CNF-17/CNF-39 — chips de tipo, raridade (da primeira variante
          listada), uma entrada por cor e, só em ≥1024px, counter (visível
          pela regra `.card-detail__chip--counter` dentro de
          `@media (min-width: 64rem)`; counter NULL não gera chip — mesma
          distinção NULL ≠ 0 do Req. 5.5). `<ul>` porque é uma lista de
          atributos, não texto solto.
        %>
        <ul class="card-detail__chips">
          <li class="card-detail__chip"><%= @card.card_type.humanize %></li>
          <% if hero.rarity.present? %>
            <li class="card-detail__chip"><%= hero.rarity %></li>
          <% end %>
          <% @card.colors.each do |color| %>
            <li class="card-detail__chip"><%= color %></li>
          <% end %>
          <% if @card.display_field?(:counter) %>
            <li class="card-detail__chip card-detail__chip--counter">Counter <%= @card.counter %></li>
          <% end %>
        </ul>

        <p class="card-detail__set">
          <%= hero.card_set.name %> · <%= hero.card_set.code %>
        </p>
        <% if @absent_variant_ids.include?(hero.id) %>
          <p class="card-detail__status">Variante fora da fonte</p>
        <% end %>
      </header>
    </div>

    <details class="card-detail__expand">
      <summary>Ver imagem maior</summary>

      <div class="card-detail__media">
        <div class="card-detail__placeholder" aria-hidden="true">
          <span><%= @card.name %></span>
          <span><%= @card.card_number %></span>
        </div>

        <% if hero.image_url.present? %>
          <%= image_tag card_image_path(hero.variant_code),
                        alt: "#{@card.name} #{hero.variant_code}",
                        class: "card-detail__image" %>
        <% end %>

        <% if hero_quantity.positive? %>
          <span class="card-detail__badge" role="img" aria-label="<%= hero_quantity == 1 ? "1 cópia" : "#{hero_quantity} cópias" %>"><%= hero_quantity %></span>
        <% end %>
      </div>

      <% if hero.illustrator.present? %>
        <p class="card-detail__illustrator">Ilustração: <%= hero.illustrator %></p>
      <% end %>
    </details>
  <% end %>

  <div class="card-detail__data">
    <%# Sem variante, o cabeçalho ainda precisa existir (mantém o teste de carta sem impressão). %>
    <% if @variants.empty? %>
      <header>
        <h1 class="card-detail__name"><%= @card.name %></h1>
        <p class="card-detail__number"><%= @card.card_number %></p>
      </header>
    <% end %>

    <%#
      Req. 5.5 — a lista de campos é filtrada por `display_field?`, que combina
      "se aplica a este tipo de carta" com "tem valor". Um campo inaplicável não
      é renderizado vazio: ele não é renderizado.

      CNF-17 (T7) — tipo e cor saíram daqui: já aparecem como chip no
      cabeçalho (`.card-detail__chips`, acima). Manter os dois nos dois
      lugares duplicaria a informação.
    %>
    <dl class="card-detail__fields">
      <% if @card.display_field?(:cost) %>
        <div class="field field--cost">
          <dt>Custo</dt>
          <dd><%= @card.cost %></dd>
        </div>
      <% end %>

      <% if @card.display_field?(:power) %>
        <div class="field field--power">
          <dt>Power</dt>
          <dd><%= @card.power %></dd>
        </div>
      <% end %>

      <% if @card.display_field?(:life) %>
        <div class="field field--life">
          <dt>Life</dt>
          <dd><%= @card.life %></dd>
        </div>
      <% end %>

      <% if @card.display_field?(:attributes_list) %>
        <div class="field field--attributes">
          <dt>Attribute</dt>
          <dd><%= @card.attributes_list.join(", ") %></dd>
        </div>
      <% end %>

      <% if @card.display_field?(:traits) %>
        <div class="field field--traits">
          <dt>Traits</dt>
          <dd><%= @card.traits.join(", ") %></dd>
        </div>
      <% end %>

      <% if @card.display_field?(:block_icon) %>
        <div class="field field--block">
          <dt>Block</dt>
          <dd><%= @card.block_icon %></dd>
        </div>
      <% end %>
    </dl>

    <%#
      Req. 5.4 — `simple_format` escapa o texto (ele vem de fonte externa) e
      converte quebra de linha em `<br>`. Interpolar direto perderia a quebra;
      `html_safe` renderizaria HTML de terceiro.
    %>
    <% if @card.effect_text.present? %>
      <section class="card-detail__effect">
        <h2>Efeito</h2>
        <%= simple_format(@card.effect_text) %>

        <%#
          CNF-18 (T7) — o trigger deixou de ter seção própria: mora dentro do
          efeito, depois do texto principal. `simple_format` (mesma chamada
          do efeito acima) preserva a quebra de linha do Req. 5.4; o rótulo
          "Trigger" é `<strong>`, não `<span>`, porque carrega significado
          semântico (destaca onde o trigger começa), não só peso visual.
        %>
        <% if @card.trigger_text.present? %>
          <p class="card-detail__trigger-label"><strong>Trigger</strong></p>
          <%= simple_format(@card.trigger_text) %>
        <% end %>
      </section>
    <% end %>
  </div>

  <%#
    DCK-03, DCK-04 — com um deck em edição, o controle de deck da carta. Ele é
    da carta, e não de uma variante: o deck referencia `cards` (design.md §10).
    Sem sessão, sem deck em edição ou com o deck em edição excluído,
    `editing_deck` é `nil` e nada aparece (DCK-41).
  %>
  <%#
    A seção fica aqui, fora do partial: o Turbo Stream troca o conteúdo do
    controle, e o título não pode ir junto (achado M5 da revisão de a11y).
  %>
  <% if editing_deck %>
    <section class="card-detail__deck" aria-labelledby="deck-controls-title">
      <h2 id="deck-controls-title">Deck em edição</h2>
      <%= render "decks/card_controls", deck: editing_deck, card: @card, quantity: @editing_deck_quantity %>
    </section>
  <% end %>

  <%#
    Req. 5.2 — a coleção referencia variantes, não cartas (design.md §3.1):
    arte base e arte alternativa são objetos de coleção distintos. Por isso
    cada variante aparece inteira, com raridade, set e imagem próprias.

    T8 (CNF-19) — título próprio e divisor de 1px antes desta seção
    (Mobile-Carta.dc.html:48-51, Desktop-Carta.dc.html:67); o divisor em si é
    `::before` na folha (mesma técnica de `.catalog__filters::before`), não um
    elemento novo — a seção de efeito é opcional (carta sem `effect_text`) e um
    divisor fixado nela sumiria junto.
  %>
  <section class="card-detail__variants">
    <h2>Variantes na pasta</h2>

    <ul class="variant-list">
      <%#
        CNF-20 — "{raridade} · {tipo de arte}", com `art_kind` traduzido:
        `base` → "arte base", `parallel` → "parallel", qualquer outro valor
        (`alternate_art`, `manga`, `promo`, `other`) → "alternativa". O mapa é
        fechado por propósito: `art_kind` é texto livre vindo de um scraper
        comunitário (design.md, "Detalhes de modelagem fáceis de errar"), e um
        `else` cobre valor novo sem quebrar a ingestão nem esta view.
      %>
      <% art_kind_labels = { "base" => "arte base", "parallel" => "parallel" } %>
      <% @variants.each do |variant| %>
        <%#
          CNF-42 — a miniatura é um link para a própria página com
          `?variant=`: a troca da imagem principal sai do servidor, sem
          JavaScript, e a URL compartilhada abre na mesma variante.
          `replace` para que trocar de variante não encha o histórico — o
          "voltar" do navegador continua levando ao catálogo.
        %>
        <% current = variant == hero %>
        <li class="variant<%= " variant--current" if current %>">
          <%= link_to card_path(@card.card_number, variant: variant.variant_code),
                      class: "variant__art",
                      aria: { label: "Mostrar #{variant.variant_code} na imagem principal",
                              current: (current ? "true" : nil) },
                      data: { turbo_action: "replace" } do %>
            <span class="variant__placeholder" aria-hidden="true">
              <span><%= @card.name %></span>
              <span><code class="code"><%= variant.variant_code %></code></span>
            </span>

            <% if variant.image_url.present? %>
              <%= image_tag card_image_path(variant.variant_code),
                            alt: "",
                            loading: "lazy",
                            class: "variant__image" %>
            <% end %>
          <% end %>

          <%#
            CNF-20 — rótulos "Código", "Raridade" e "Set" no HTML e fora da
            vista (`.variant__meta dt`, recorte já existente na folha).
          %>
          <dl class="variant__meta">
            <div>
              <dt>Código</dt>
              <dd class="variant__code"><%= variant.variant_code %></dd>
            </div>
            <% if variant.rarity.present? %>
              <div>
                <dt>Raridade</dt>
                <dd class="variant__rarity">
                  <%= [ variant.rarity, art_kind_labels.fetch(variant.art_kind, "alternativa") ].join(" · ") %>
                </dd>
              </div>
            <% end %>
            <%# SRC-17 — ausente da fonte, visível só ao dono do item. Texto, não só cor. %>
            <% if @absent_variant_ids.include?(variant.id) %>
              <div>
                <dt>Situação</dt>
                <dd>fora da fonte</dd>
              </div>
            <% end %>
            <div>
              <dt>Set</dt>
              <dd class="variant__set">
                <%= variant.card_set.name %> (<%= variant.card_set.code %>)
              </dd>
            </div>
          </dl>

          <%#
            Req. 5.3 / COL-18 — o controle de posse fica **em cada variante**,
            dentro do loop que já existe. Aqui não há ambiguidade nenhuma: a
            variante aparece inteira, com código, raridade, set e imagem, e o
            botão pertence visivelmente a ela.
          %>
          <%= render "collection_items/ownership",
                     variant: variant, card: @card, quantity: owned_quantity(variant) %>

          <%#
            Req. 8.1 / COL-14 — marcar a impressão como desejada. Fica aqui e
            não na grade: o tile não comporta um segundo controle em 360px sem
            espremer o de posse (a justificativa longa está no próprio partial).

            Só para quem tem sessão, pelo mesmo motivo do controle de posse: o
            catálogo é público (Req. 6.3) e um formulário que sempre redireciona
            para o login seria promessa quebrada.
          %>
          <% if authenticated? %>
            <%= render "wishlist_items/mark",
                       variant: variant, card: @card,
                       target_quantity: wishlist_target(variant),
                       marked: wishlist_target(variant).present? %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
</main>
