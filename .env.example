# Copie para `.env` antes de `docker compose up`.
# Credenciais locais de desenvolvimento — não use estes valores em produção.
POSTGRES_USER=bindr
POSTGRES_PASSWORD=bindr
POSTGRES_DB=bindr_development
POSTGRES_TEST_DB=bindr_test

# Chave da apitcg (AD-019). Obrigatória só para `ingestion:import` sem
# `SNAPSHOT=`; os testes não a usam. Nunca commite o valor.
APITCG_API_KEY=
